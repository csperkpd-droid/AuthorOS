# ─── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d` starts Postgres with these credentials.
# Vercel + Neon: the integration sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used by migrations) automatically.
DATABASE_URL="postgresql://authoros:authoros@localhost:5432/authoros"
# DATABASE_URL_UNPOOLED=""

# Used by `pnpm test` (integration tests truncate this database).
TEST_DATABASE_URL="postgresql://authoros:authoros@localhost:5432/authoros_test"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# Google sign-in (optional locally; the button is hidden when unset).
# Redirect URI: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Email (magic links) ─────────────────────────────────────────────────────
# Without AUTH_RESEND_KEY, sign-in links are printed to the console and written
# to .dev-mail/outbox.jsonl instead of being emailed.
AUTH_RESEND_KEY=""
EMAIL_FROM="Spellbound Draft <onboarding@resend.dev>"
# EMAIL_TRANSPORT="outbox"   # force the local outbox even with a Resend key
