// AuthorOS database schema.
//
// Conventions (see docs/DATABASE.md):
// - Every domain row is scoped to a Workspace (the tenancy boundary).
// - Primary keys are UUIDv7 (time-ordered, index friendly, safe to expose).
// - Tables and columns are snake_case in Postgres, camelCase in Prisma.
// - Creative content gets soft delete (`deletedAt`) so authors can restore from Trash.
//
// - Story objects share one identity space: `story_nodes` (the Story Graph
//   extension point). Each series/book/part/chapter/scene row's primary key is
//   also a story node id.
// - References to rows in the same workspace use composite foreign keys that
//   include `workspace_id`, so the database rejects cross-workspace links.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (Auth.js adapter tables) ──────────────────────────────────────

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  /// IANA time zone for "today" (writing days, due dates). Null = not set yet.
  timeZone      String?   @map("time_zone")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  memberships WorkspaceMember[]
  revisions   ContentRevision[]
  connections Connection[]
  writing     WritingSession[]

  @@map("users")
}

model Account {
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

/// The ownership boundary for all author data. In the MVP every user gets
/// exactly one personal workspace; collaboration later adds members to it.
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members    WorkspaceMember[]
  penNames   PenName[]
  storyNodes StoryNode[]
  templates  StructureTemplate[]
  kits       TemplateKit[]
  writing    WritingSession[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER

  @@map("workspace_role")
}

model WorkspaceMember {
  workspaceId     String        @map("workspace_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  role            WorkspaceRole @default(OWNER)
  /// The identity this member is currently working as. Null = all identities.
  activePenNameId String?       @map("active_pen_name_id") @db.Uuid
  /// Words per day this member aims for. Null = no daily goal.
  dailyWordGoal   Int?          @map("daily_word_goal")
  createdAt       DateTime      @default(now()) @map("created_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePenName PenName?  @relation(fields: [activePenNameId], references: [id], onDelete: SetNull)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ─── Author identities ──────────────────────────────────────────────────────

/// An author identity the workspace publishes under. Series and books belong
/// to exactly one pen name. Pen names are archived, never deleted, so the
/// books written under them keep their attribution.
/// Constraints (hand-written in migrations): at most one default per
/// workspace; the default cannot be archived.
model PenName {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  bio         String?
  isDefault   Boolean   @default(false) @map("is_default")
  /// Writing language (BCP 47, e.g. "en"): search stemming for this identity's work. Null = no language rules.
  language    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  /// Pen names are story nodes (M7): connectable like other story objects.
  node             StoryNode         @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  series           Series[]
  books            Book[]
  characters       Character[]
  fieldDefinitions FieldDefinition[]
  activeMembers    WorkspaceMember[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("pen_names")
}

// ─── Story graph ────────────────────────────────────────────────────────────

enum StoryNodeKind {
  SERIES
  BOOK
  PART
  CHAPTER
  SCENE
  CHARACTER
  RELATIONSHIP
  NOTE
  IDEA
  OUTLINE
  TASK
  EVENT
  PEN_NAME

  @@map("story_node_kind")
}

/// The universal identity of every story object. Typed tables (books,
/// scenes…) use their node id as their primary key, so future cross-cutting
/// features (connections, tags, comments, search) can reference any object
/// with a real foreign key. A trigger deletes the node when its row is deleted.
model StoryNode {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  kind        StoryNodeKind
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  series       Series?
  book         Book?
  part         Part?
  chapter      Chapter?
  scene        Scene?
  character    Character?
  relationship Relationship?
  note         Note?
  idea         Idea?
  outline      Outline?
  task         Task?
  event        CalendarEvent?    @relation("EventNode")
  penName      PenName?
  /// Calendar entries about this object (e.g. a book's deadline).
  dates        CalendarEvent[]   @relation("EventSubject")
  outgoing     Connection[]      @relation("ConnectionSource")
  incoming     Connection[]      @relation("ConnectionTarget")
  revisions    ContentRevision[]
  fieldValues  NodeFieldValue[]

  @@unique([id, workspaceId])
  @@index([workspaceId, kind])
  @@map("story_nodes")
}

// ─── Library: series and books ──────────────────────────────────────────────

model Series {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  penNameId   String    @map("pen_name_id") @db.Uuid
  title       String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  node       StoryNode         @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  penName    PenName           @relation(fields: [penNameId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  characters Character[]
  books      Book[]
  outlines   Outline[]
  fields     FieldDefinition[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([penNameId])
  @@map("series")
}

enum BookStatus {
  PLANNING
  DRAFTING
  REVISING
  COMPLETE
  PUBLISHED

  @@map("book_status")
}

model Book {
  id              String     @id @db.Uuid
  workspaceId     String     @map("workspace_id") @db.Uuid
  penNameId       String     @map("pen_name_id") @db.Uuid
  seriesId        String?    @map("series_id") @db.Uuid
  /// Fractional-index key for the book's place in its series (C collation).
  seriesPosition  String?    @map("series_position")
  title           String
  subtitle        String?
  description     String?
  status          BookStatus @default(PLANNING)
  targetWordCount Int?       @map("target_word_count")
  /// Romance metadata (any genre may use tropes).
  tropes          String[]   @default([])
  heatLevel       HeatLevel? @map("heat_level")
  /// Deadline for the current draft (shown on the calendar and dashboard).
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  node         StoryNode         @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  penName      PenName           @relation(fields: [penNameId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  series       Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  parts        Part[]
  chapters     Chapter[]
  scenes       Scene[]
  outlines     Outline[]
  plannedBeats OutlineBeat[]
  fields       FieldDefinition[]
  writing      WritingSession[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([penNameId])
  @@index([seriesId])
  @@map("books")
}

enum HeatLevel {
  CLEAN
  CLOSED_DOOR
  OPEN_DOOR
  EXPLICIT

  @@map("heat_level")
}

// ─── Manuscript structure: Book → (Part) → Chapter → Scene ─────────────────
//
// Parts are optional. A book's top level is an ordered mix of parts and
// part-less chapters (e.g. Prologue, Part One, Part Two, Epilogue) sharing one
// position space. `position` columns are fractional-index keys (C collation).

model Part {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  bookId      String    @map("book_id") @db.Uuid
  title       String
  position    String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  node     StoryNode @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  book     Book      @relation(fields: [bookId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  chapters Chapter[]

  @@unique([id, workspaceId])
  @@unique([id, bookId])
  @@index([bookId])
  @@map("parts")
}

model Chapter {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  bookId      String    @map("book_id") @db.Uuid
  /// Null = the chapter sits at the book's top level.
  partId      String?   @map("part_id") @db.Uuid
  title       String
  position    String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  node   StoryNode @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  book   Book      @relation(fields: [bookId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  part   Part?     @relation(fields: [partId], references: [id], onDelete: Cascade)
  scenes Scene[]

  @@unique([id, workspaceId])
  @@unique([id, bookId])
  @@index([bookId])
  @@index([partId])
  @@map("chapters")
}

enum SceneStatus {
  OUTLINED
  DRAFT
  REVISED
  FINAL

  @@map("scene_status")
}

model Scene {
  id          String      @id @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  bookId      String      @map("book_id") @db.Uuid
  chapterId   String      @map("chapter_id") @db.Uuid
  title       String
  position    String
  status      SceneStatus @default(DRAFT)
  synopsis    String?
  /// ProseMirror (Tiptap) document JSON. Null = empty scene.
  content     Json?
  /// Plain text derived from `content`, for search and word counts.
  contentText String      @default("") @map("content_text")
  wordCount   Int         @default(0) @map("word_count")
  /// Incremented on every content save; used to detect conflicting edits.
  version     Int         @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  node    StoryNode   @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  book    Book        @relation(fields: [bookId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  chapter Chapter     @relation(fields: [chapterId, bookId], references: [id, bookId], onDelete: Cascade)
  beats   BeatScene[]

  @@unique([id, workspaceId])
  @@index([bookId])
  @@index([chapterId])
  @@map("scenes")
}

enum RevisionSource {
  AUTOSAVE
  MANUAL
  BEFORE_RESTORE
  AI_ACCEPTED
  IMPORT

  @@map("revision_source")
}

/// Append-only snapshots of earlier rich-text content of any versioned story
/// node (scenes and notes today). Never pruned automatically.
model ContentRevision {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  nodeId      String         @map("node_id") @db.Uuid
  content     Json?
  contentText String         @map("content_text")
  wordCount   Int            @map("word_count")
  source      RevisionSource
  label       String?
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  node      StoryNode @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt(sort: Desc)])
  @@map("content_revisions")
}

// ─── Story bible ────────────────────────────────────────────────────────────

enum CharacterRole {
  PROTAGONIST
  ANTAGONIST
  LOVE_INTEREST
  SUPPORTING
  MINOR

  @@map("character_role")
}

/// A character belongs to one author identity (pen name) and optionally to a
/// series of that identity. Identities are private from each other by
/// default. Scene appearances are connections (`appears_in`).
model Character {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  penNameId   String        @map("pen_name_id") @db.Uuid
  seriesId    String?       @map("series_id") @db.Uuid
  name        String
  aliases     String[]      @default([])
  role        CharacterRole @default(SUPPORTING)
  summary     String?
  /// Profile fields (age, appearance, goal…) keyed by field id. See
  /// modules/characters/profile.ts for the known fields.
  profile     Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  node        StoryNode            @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  penName     PenName              @relation(fields: [penNameId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  series      Series?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  memberships RelationshipMember[]
  outlines    Outline[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([penNameId])
  @@index([seriesId])
  @@map("characters")
}

/// A relationship between two characters. It is a story node itself, so
/// notes, scenes ("develops_in") and future romance arcs can connect to it.
/// The pair is stored in id order (CHECK) and is unique.
/// A relationship between two or more characters (a couple, a triangle, a
/// Why Choose/reverse-harem group, a family). Members are rows in
/// relationship_members; the relationships between individual members of a
/// group are relationships of their own.
model Relationship {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// Sorted member ids joined by ","; one relationship per exact set of members.
  memberKey   String    @map("member_key")
  type        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  node     StoryNode            @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  members  RelationshipMember[]
  outlines Outline[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, memberKey])
  @@index([workspaceId])
  @@map("relationships")
}

model RelationshipMember {
  workspaceId    String   @map("workspace_id") @db.Uuid
  relationshipId String   @map("relationship_id") @db.Uuid
  characterId    String   @map("character_id") @db.Uuid
  /// Display order of the members.
  position       Int
  /// This member's role in this relationship ("Heroine", "FMC", "Rival"…). Optional.
  role           String?
  createdAt      DateTime @default(now()) @map("created_at")

  relationship Relationship @relation(fields: [relationshipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  character    Character    @relation(fields: [characterId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([relationshipId, characterId])
  @@index([characterId])
  @@map("relationship_members")
}

model Note {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  /// ProseMirror document JSON. Null = empty note.
  body        Json?
  bodyText    String    @default("") @map("body_text")
  /// Incremented on every body save (conflict detection, like scenes).
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  node StoryNode @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("notes")
}

enum IdeaStatus {
  OPEN
  USED
  ARCHIVED

  @@map("idea_status")
}

model Idea {
  id          String     @id @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  title       String
  body        String?
  status      IdeaStatus @default(OPEN)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  node StoryNode @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("ideas")
}

// ─── Universal connections ──────────────────────────────────────────────────

/// A link between any two story nodes. Which kinds of link exist, which node
/// kinds they may join, their wording and their attributes are defined in
/// code (modules/connections/registry.ts), so new object types can take part
/// without schema changes. Both endpoints use tenant-safe FKs and cascade:
/// a connection disappears with either endpoint.
/// Hand-written constraints: no self-links; at most one POV per scene.
model Connection {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  sourceId    String   @map("source_id") @db.Uuid
  targetId    String   @map("target_id") @db.Uuid
  /// Registry key, e.g. "appears_in", "about", "related".
  kind        String
  /// The author's own wording for this link (optional).
  label       String?
  note        String?
  /// Kind-specific values validated by the registry (e.g. { role: "POV" }).
  attributes  Json     @default("{}")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  source    StoryNode @relation("ConnectionSource", fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  target    StoryNode @relation("ConnectionTarget", fields: [targetId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceId, targetId, kind])
  @@index([targetId])
  @@index([workspaceId, kind])
  @@map("connections")
}

// ─── Story structure ────────────────────────────────────────────────────────

enum StructureKind {
  PLOT
  ROMANCE
  CHARACTER_ARC
  SUBPLOT
  CUSTOM

  @@map("structure_kind")
}

/// A beat-sheet template. `workspace_id` null = built-in (seeded by migration
/// with fixed ids); otherwise the author's own (future: save outline as template).
model StructureTemplate {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String?       @map("workspace_id") @db.Uuid
  kind        StructureKind
  name        String
  description String?
  source      String?
  /// Saved from a series structure: beats carry a book number.
  forSeries   Boolean       @default(false) @map("for_series")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  beats     TemplateBeat[]
  kitItems  TemplateKitItem[]
  outlines  Outline[]

  @@index([workspaceId])
  @@map("structure_templates")
}

model TemplateBeat {
  id            String  @id @default(uuid(7)) @db.Uuid
  templateId    String  @map("template_id") @db.Uuid
  title         String
  description   String?
  /// Where the beat usually falls, as a percentage of the book.
  targetPercent Int?    @map("target_percent")
  position      String
  /// Series templates: which book (1 = first) the beat belongs to.
  bookIndex     Int?    @map("book_index")

  template     StructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  outlineBeats OutlineBeat[]

  @@index([templateId])
  @@map("template_beats")
}

/// A structure applied to a book: the main plot, a romance arc (owned by a
/// relationship), a character arc (owned by a character), a subplot or a
/// custom structure. A story node, so notes and other objects connect to it.
/// CHECK: romance arcs have a relationship, character arcs a character.
enum ArcRole {
  MAIN
  SECONDARY

  @@map("arc_role")
}

model Outline {
  id             String        @id @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  /// Exactly one of book_id / series_id: a structure for one book, or one
  /// spanning a whole series (e.g. a series-long romance arc).
  bookId         String?       @map("book_id") @db.Uuid
  seriesId       String?       @map("series_id") @db.Uuid
  kind           StructureKind
  title          String
  templateId     String?       @map("template_id") @db.Uuid
  relationshipId String?       @map("relationship_id") @db.Uuid
  characterId    String?       @map("character_id") @db.Uuid
  /// For romance arcs: main or secondary couple (Romance Center ordering).
  arcRole        ArcRole?      @map("arc_role")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  node         StoryNode          @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  book         Book?              @relation(fields: [bookId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  series       Series?            @relation(fields: [seriesId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  template     StructureTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  relationship Relationship?      @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  character    Character?         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  beats        OutlineBeat[]

  @@unique([id, workspaceId])
  @@index([bookId])
  @@index([seriesId])
  @@index([relationshipId])
  @@index([characterId])
  @@map("outlines")
}

/// One beat of an outline (copied from the template, then the author's own).
model OutlineBeat {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  outlineId      String   @map("outline_id") @db.Uuid
  templateBeatId String?  @map("template_beat_id") @db.Uuid
  title          String
  description    String?
  targetPercent  Int?     @map("target_percent")
  position       String
  /// In a series structure, the book this beat is planned for (grouping only;
  /// its scenes may be in any book of the series).
  bookId         String?  @map("book_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  outline      Outline       @relation(fields: [outlineId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  templateBeat TemplateBeat? @relation(fields: [templateBeatId], references: [id], onDelete: SetNull)
  scenes       BeatScene[]
  book         Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@unique([id, workspaceId])
  @@index([outlineId])
  @@map("outline_beats")
}

/// Structural beat assignment: this beat happens in this scene. Many-to-many,
/// so a beat can span several scenes and one scene can carry beats of many
/// structures. The scene itself is never copied.
model BeatScene {
  workspaceId String   @map("workspace_id") @db.Uuid
  beatId      String   @map("beat_id") @db.Uuid
  sceneId     String   @map("scene_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  beat  OutlineBeat @relation(fields: [beatId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  scene Scene       @relation(fields: [sceneId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([beatId, sceneId])
  @@index([sceneId])
  @@map("beat_scenes")
}

// ─── Custom fields ──────────────────────────────────────────────────────────

enum FieldType {
  TEXT
  LONG_TEXT

  @@map("field_type")
}

/// An author-defined field for a kind of story object (e.g. "Magic type" on
/// characters). `pen_name_id` null = shown for every identity.
model FieldDefinition {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  /// Scope: at most one of pen name, series, book. None = all identities.
  penNameId   String?       @map("pen_name_id") @db.Uuid
  seriesId    String?       @map("series_id") @db.Uuid
  bookId      String?       @map("book_id") @db.Uuid
  nodeKind    StoryNodeKind @map("node_kind")
  label       String
  type        FieldType     @default(TEXT)
  position    String
  createdAt   DateTime      @default(now()) @map("created_at")

  penName PenName?         @relation(fields: [penNameId], references: [id], onDelete: Cascade)
  series  Series?          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  book    Book?            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  values  NodeFieldValue[]

  @@unique([id, workspaceId])
  @@index([workspaceId, nodeKind])
  @@map("field_definitions")
}

/// A custom field's value on any story node.
model NodeFieldValue {
  workspaceId String   @map("workspace_id") @db.Uuid
  nodeId      String   @map("node_id") @db.Uuid
  fieldId     String   @map("field_id") @db.Uuid
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")

  node  StoryNode       @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  field FieldDefinition @relation(fields: [fieldId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([nodeId, fieldId])
  @@index([fieldId])
  @@map("node_field_values")
}

// ─── Milestone 4: getting work done ─────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH

  @@map("task_priority")
}

/// A to-do. A story node, so what it concerns is a set of `concerns`
/// connections. Author-level (shared across identities), like notes.
model Task {
  id          String       @id @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  title       String
  notes       String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)
  dueOn       DateTime?    @map("due_on") @db.Date
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  node StoryNode @relation(fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, dueOn])
  @@map("tasks")
}

/// A dated event on the author's calendar (launch, conference, edit due…).
/// A story node, so it can concern books and other story objects.
model CalendarEvent {
  id          String          @id @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  title       String
  description String?
  startsOn    DateTime        @map("starts_on") @db.Date
  /// Last day of a multi-day event (inclusive). Null = one day.
  endsOn      DateTime?       @map("ends_on") @db.Date
  /// "HH:MM" local time. Null = all day.
  startTime   String?         @map("start_time")
  /// What the entry is: an event of its own, or a date that belongs to
  /// another story object (`subjectId`), such as a book's deadline.
  purpose     CalendarPurpose @default(EVENT)
  subjectId   String?         @map("subject_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  node    StoryNode  @relation("EventNode", fields: [id, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  subject StoryNode? @relation("EventSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, startsOn])
  @@index([subjectId])
  @@map("calendar_events")
}

/// Dates live in one place (M7): every dated entry is a calendar event.
/// DEADLINE entries belong to a subject (one live deadline per subject).
enum CalendarPurpose {
  EVENT
  DEADLINE

  @@map("calendar_purpose")
}

enum WritingSource {
  /// Recorded automatically from scene saves (one row per user, book, day).
  EDITOR
  /// Logged by the author (words written elsewhere).
  MANUAL

  @@map("writing_source")
}

/// Words written per day: the basis for daily totals, streaks and goals.
model WritingSession {
  id           String        @id @default(uuid(7)) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  bookId       String?       @map("book_id") @db.Uuid
  /// The author's local date.
  date         DateTime      @db.Date
  source       WritingSource
  wordsAdded   Int           @default(0) @map("words_added")
  wordsRemoved Int           @default(0) @map("words_removed")
  minutes      Int?
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, date])
  @@index([bookId])
  @@map("writing_sessions")
}

// ─── Milestone 5: template kits ─────────────────────────────────────────────

enum KitItemType {
  /// A structure template (plot, romance, character arc, subplot, custom).
  STRUCTURE

  @@map("kit_item_type")
}

/// A named set of templates applied together ("My Romantasy Book Kit").
/// Applying a kit creates independent new structures, like each template.
model TemplateKit {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     TemplateKitItem[]

  @@index([workspaceId])
  @@map("template_kits")
}

model TemplateKitItem {
  id         String      @id @default(uuid(7)) @db.Uuid
  kitId      String      @map("kit_id") @db.Uuid
  /// Room for other kinds of templates (e.g. publishing workflows, v1.1).
  itemType   KitItemType @default(STRUCTURE) @map("item_type")
  templateId String      @map("template_id") @db.Uuid
  position   Int

  kit      TemplateKit       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  template StructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([kitId])
  @@index([templateId])
  @@map("template_kit_items")
}
